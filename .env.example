# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/syncscope_db
# Or use individual settings:
DB_NAME=syncscope_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Use SQLite for local development (optional)
USE_SQLITE=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/2
# Or use individual settings:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=django-db

# Service URLs
AUTH_SERVICE_URL=https://syncscope-auth-service-dev.up.railway.app
ANALYTICS_SERVICE_URL=http://localhost:8000
MONITORING_SERVICE_URL=http://localhost:8001
MANAGEMENT_SERVICE_URL=http://localhost:8002

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache Configuration
CACHE_TIMEOUT=300

# Rate Limiting
RATELIMIT_ENABLE=True

# Alert Configuration
ALERT_EVALUATION_INTERVAL=60
MAX_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=300
ALERT_RETENTION_DAYS=90

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@syncscope.com

# SendGrid Configuration (API-based email sending)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Free tier: 100 emails/day forever
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@syncscope.com

# Production Settings (Railway)
RAILWAY_ENVIRONMENT=production
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
